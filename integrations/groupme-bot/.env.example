# Copy to .env and fill in. NEVER commit the real .env to git.
# The bot_id and secret stay in Sayed's hands — the agent never stores them.

# From https://dev.groupme.com/bots after you create the bot:
GROUPME_BOT_ID=

# A long random string YOU invent. It goes in the callback URL:
#   https://your-host/webhook/<CALLBACK_SECRET>
# Anyone without it gets a 403. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_SECRET=

# Port the server listens on (default 8000):
PORT=8000

# Optional: where the bot keeps notes/memory (defaults to ./data):
# BOT_DATA_DIR=
