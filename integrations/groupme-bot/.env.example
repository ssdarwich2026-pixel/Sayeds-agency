# Copy to .env and fill in. NEVER commit the real .env to git.
# The bot_id and secret stay in Sayed's hands — the agent never stores them.

# From https://dev.groupme.com/bots after you create the bot:
GROUPME_BOT_ID=

# --- Polling transport (PRIMARY — the review council's verdict) ---
# Full-account OAuth token. Get it at https://dev.groupme.com/applications:
#   1. "Create Application" (name it e.g. "Sayeds Agency"; callback URL can
#      be anything, e.g. https://localhost — you'll copy the token by hand).
#   2. Visit https://oauth.groupme.com/oauth/authorize?client_id=YOUR_CLIENT_ID
#   3. Sign in, tap Authorize. Your browser lands on the callback URL with
#      ?access_token=XXXX appended — copy that token.
# It is LONG-LIVED (no expiry unless you revoke it) and it is a
# FULL-ACCOUNT credential: it can read every group and act as you.
# .env / GitHub Secrets ONLY. Never chat, logs, or screenshots.
GROUPME_USER_TOKEN=

# Which groups to poll. Preferred form — one line, group_id -> bot_id:
GROUPS_JSON={"12345678": "paste-bot-id-for-that-group"}
# Alternative for the single-group case (reuses GROUPME_BOT_ID above):
# GROUP_IDS=12345678

# --- Webhook transport (alternative — only if you want instant replies) ---
# A long random string YOU invent. It goes in the callback URL:
#   https://your-host/webhook/<CALLBACK_SECRET>
# Anyone without it gets a 403. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CALLBACK_SECRET=

# Port the server listens on (default 8000):
PORT=8000

# Optional: where the bot keeps notes/memory (defaults to ./data):
# BOT_DATA_DIR=
